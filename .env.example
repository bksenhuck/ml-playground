# ─────────────────────────────────────────────────────────────────────────────
# ML Playground — environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Cloud Platform ────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# ── Cloud Run ────────────────────────────────────────────────────────────────
CLOUDRUN_SERVICE=ml-playground
# Full image URI — leave blank to auto-build as gcr.io/{GCP_PROJECT_ID}/ml-playground
GCR_IMAGE=

# ── Qwen 2.5 LLM assistant ──────────────────────────────────────────────────
USE_LLM=true
MODEL_PATH=/app/models/Qwen2.5-0.5B-Instruct
GCS_MODEL_PATH=gs://your-bucket-name/models/Qwen2.5-0.5B-Instruct

