# ─────────────────────────────────────────────────────────────────────────────
# ML Playground — environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Cloud Platform ────────────────────────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# ── Cloud Run ────────────────────────────────────────────────────────────────
CLOUDRUN_SERVICE=ml-playground
# Full image URI — leave blank to auto-build as gcr.io/{GCP_PROJECT_ID}/ml-playground
GCR_IMAGE=

# ── Gemini LLM assistant (optional) ─────────────────────────────────────────
# Set USE_GEMINI=true and authenticate with: gcloud auth application-default login
USE_GEMINI=false
GEMINI_MODEL=gemini-2.0-flash
